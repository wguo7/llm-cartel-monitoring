+def _log_usage(model, response):
+    """Append token counts to $USAGE_LOG (sprint addition: measured cost per call)."""
+    path = os.getenv("USAGE_LOG")
+    u = getattr(response, "usage", None)
+    if not path or u is None:
+        return
+    cached = getattr(getattr(u, "prompt_tokens_details", None), "cached_tokens", 0) or 0
+    import json
+    with open(path, "a") as f:
+        f.write(json.dumps({"model": model, "prompt": u.prompt_tokens, "cached": cached,
+                            "completion": u.completion_tokens}) + "\n")
+
